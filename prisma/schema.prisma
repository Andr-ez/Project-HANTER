datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../Backend/node_modules/.prisma/client"
}

model Rol {
  id_rol     Int        @id @default(autoincrement())
  nombre_rol String     @unique
  empleados  Empleado[]
}

model Empleado {
  id_empleado   Int      @id @default(autoincrement())
  nombre        String
  apellido      String
  correo        String   @unique
  documento     String   @unique
  celular       String   @unique
  fecha_ingreso DateTime @default(now())
  foto_perfil   String?

  id_rol Int
  rol    Rol @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade)

  usuario        Usuario?
  certificados   Certificado[]
  nominas        Nomina[]
  capacitaciones EmpleadoCapacitacion[]
  notificaciones Notificacion[]
}

model Usuario {
  id_usuario     Int       @id @default(autoincrement())
  nombre_usuario String    @unique
  password_hash  String
  ultimo_login   DateTime?

  id_empleado Int      @unique
  empleado    Empleado @relation(fields: [id_empleado], references: [id_empleado], onDelete: Cascade)

  certificados_emitidos Certificado[] @relation("Emisor")
}

model Certificado {
  id_certificado  Int      @id @default(autoincrement())
  titulo          String
  institucion     String
  fecha_cert      String                        // Fecha que el empleado escribe (DD/MM/AA)
  estado          String   @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO
  fecha_solicitud DateTime @default(now())
  fecha_emision   DateTime?
  url_archivo     String                        // ruta relativa a uploads/certificados/

  id_empleado Int
  empleado    Empleado @relation(fields: [id_empleado], references: [id_empleado], onDelete: Cascade)

  id_usuario_emisor Int?
  emisor            Usuario? @relation("Emisor", fields: [id_usuario_emisor], references: [id_usuario], onDelete: SetNull)
}

model Nomina {
  id_nomina    Int      @id @default(autoincrement())
  mes          Int
  anio         Int
  url_archivo  String
  fecha_carga  DateTime @default(now())

  id_empleado Int
  empleado    Empleado @relation(fields: [id_empleado], references: [id_empleado], onDelete: Cascade)
}

model EmpleadoCapacitacion {
  id_capacitacion     Int       @id @default(autoincrement())
  nombre_capacitacion String
  fecha_inicio        DateTime
  fecha_fin           DateTime?

  id_empleado Int
  empleado    Empleado @relation(fields: [id_empleado], references: [id_empleado], onDelete: Cascade)
}

model Notificacion {
  id_notificacion Int      @id @default(autoincrement())
  mensaje         String
  leida           Boolean  @default(false)
  fecha_creacion  DateTime @default(now())

  id_empleado Int
  empleado    Empleado @relation(fields: [id_empleado], references: [id_empleado], onDelete: Cascade)
}
