// Un curso que el administrador crea desde la página 125-A.
model Curso {
  id_curso       Int      @id @default(autoincrement())
  nombre         String
  tipo           String                            // categoría: TECNOLOGÍA, IDIOMAS, etc.
  fecha_inicio   DateTime
  descripcion    String?
  activo         Boolean  @default(true)            // si sigue disponible para inscripción
  fecha_creacion DateTime @default(now())

  inscripciones Inscripcion[]
}

// Solicitud de un empleado para inscribirse a un curso.
model Inscripcion {
  id_inscripcion  Int       @id @default(autoincrement())
  estado          String    @default("PENDIENTE")  // PENDIENTE | MATRICULADO | DECLINADO | EN_PROGRESO | COMPLETADO
  fecha_solicitud DateTime  @default(now())
  fecha_decision  DateTime?

  id_empleado Int
  empleado    Empleado @relation(fields: [id_empleado], references: [id_empleado], onDelete: Cascade)

  id_curso Int
  curso    Curso @relation(fields: [id_curso], references: [id_curso], onDelete: Cascade)
}
