datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../Backend/node_modules/.prisma/client"
}

model Rol {
  id_rol     Int        @id @default(autoincrement())
  nombre_rol String     @unique
  empleados  Empleado[]
}

